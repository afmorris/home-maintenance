# Application server
PORT=8080
DATA_DIR=./data
APP_TIMEZONE=America/New_York
LOG_FORMAT=text

# Authentication: none or password
AUTH_MODE=none
APP_PASSWORD=change-me
SESSION_SECRET=

# Database: leave unset for SQLite, or set a Postgres URL
DATABASE_URL=postgres://hm:hm@127.0.0.1:5432/home_maintenance

# Notifications
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=home-maintenance
NTFY_TOKEN=
DIGEST_HOUR=8

# API
API_TOKEN=
